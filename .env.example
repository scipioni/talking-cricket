# Telegram
CALOBOT_TELEGRAM_BOT_TOKEN=

# LLM gateway (OpenAI-compatible). Defaults point at the self-hosted Ollama endpoint.
CALOBOT_LLM_BASE_URL=https://ingegno.csgalileo.org/ollama/v1
CALOBOT_LLM_API_KEY=ollama
CALOBOT_LLM_MODEL=qwen3-vl:30b-a3b-instruct
CALOBOT_LLM_TEMPERATURE=0.2
CALOBOT_LLM_TIMEOUT_SECONDS=30
CALOBOT_LLM_RETRY_LIMIT=2

# Optional per-step overrides (fall back to the values above when unset)
CALOBOT_LLM_CLASSIFY_MODEL=
CALOBOT_LLM_CLASSIFY_TEMPERATURE=
CALOBOT_LLM_EXTRACT_MODEL=
CALOBOT_LLM_EXTRACT_TEMPERATURE=

# Persistence
CALOBOT_DATABASE_PATH=/data/calobot.db

# Behaviour
CALOBOT_BOT_LABEL=Grillo Parlante
CALOBOT_TIMEZONE_NAME=Europe/Rome
CALOBOT_DRAFT_EXPIRY_MINUTES=30
# Consecutive unusable answers to the same clarification before the bot stops
# asking, drops the draft and says so. Must not exceed the simulation harness's
# progress bound, or correct give-up behaviour fails every simulation run.
CALOBOT_CLARIFICATION_ATTEMPT_LIMIT=3

# Ops
CALOBOT_LOG_LEVEL=INFO
